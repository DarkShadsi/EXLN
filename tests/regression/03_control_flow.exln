// Step 5: if, while, for, do-while, break, continue, switch
if (0) println "t";
if (null) println "never";
if (1 > 2) { println "a"; } else { println "b"; }

var i = 0;
while (i < 3) { println i; i = i + 1; }

for (var j = 0; j < 5; j = j + 1) { if (j == 2) continue; println j; }
for (var k = 0; k < 5; k = k + 1) { if (k == 3) break; println k; }
for (;;) { break; }

// break only leaves the inner loop
for (var a = 0; a < 2; a = a + 1) {
    for (var b = 0; b < 3; b = b + 1) {
        if (b == 1) break;
        println a + b;
    }
}

var x = 10;
do { println x; x = x + 1; } while (x < 5);

var n = 0;
do { n = n + 1; if (n == 2) continue; println n; } while (n < 3);

// no fallthrough
switch (2) { case 1: println "a"; case 2: println "b"; case 3: println "c"; default: println "d"; }
switch (9) { case 1: println "a"; default: println "d"; }
switch (9) { case 1: println "a"; }

// break inside a switch leaves the enclosing loop
for (var m = 0; m < 3; m = m + 1) {
    switch (m) {
        case 1: break;
        default: println m;
    }
}
