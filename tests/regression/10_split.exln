// split(text, separator): pieces between separators, in order. Empty pieces are kept.
var t = split("a b c", " ");
println length(t);
println t[0];
println t[2];

var u = split("a,,b", ",");
println length(u);
println u[1] == "";

println length(split("abc", " "));
println split("1 + 2", " ");
println length(split("", " "));
println split("a--b--c", "--");
