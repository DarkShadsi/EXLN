// Step 8: enums
enum Color { RED, GREEN, BLUE }
enum Size { SMALL, MEDIUM, LARGE }

println Color.GREEN;
println Color.GREEN.order();
var all = Color.values();
println length(all);
println all[2];
println Color.RED == Color.RED;
println Color.RED != Color.BLUE;
println Color.RED == 0;
if (Color.RED) println "t";

var c = Color.RED;
switch (c) {
    case Color.RED:   println "Stop";
    case Color.GREEN: println "Go";
    default:          println "?";
}

println Color;
var next = c;
println next == Color.RED;

for (var i = 0; i < length(all); i = i + 1) {
    println all[i].order();
}

// nested loops with break
var sizes = Size.values();
for (var s = 0; s < length(sizes); s = s + 1) {
    for (var k = 0; k < length(all); k = k + 1) {
        if (all[k] == Color.BLUE) break;
        println sizes[s].order() * 10 + all[k].order();
    }
}
