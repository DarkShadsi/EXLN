// Step 7: static (lexical) scoping
var a = "global";
{
    func show() { println a; }
    show();
    var a = "block";
    show();
}

var b = 1;
{
    var b = 2;
    {
        println b;
    }
}
println b;

func outer() {
    var x = "outer";
    func inner() { return x; }
    return inner;
}
println outer()();
