// Step 9: classes, init, inheritance, super, overloading, polymorphism
class A {}
println A;
var a = A();
println a;
a.name = "Al";
println a.name;

class B { show() { println this.x; } }
var b = B();
b.x = 5;
b.show();
var m = b.show;
m();

// init
class Q { init(n) { this.name = n; } }
println Q("Bo").name;
class R { init() { return; } }
println R().init();

// overloaded constructors and methods
class V { init() { this.x = 0; } init(x) { this.x = x; } }
println V().x;
println V(7).x;
class S { area(s) { return s * s; } area(w, h) { return w * h; } }
var sq = S();
println sq.area(3);
println sq.area(2, 5);

// inheritance, overriding, super
class D1 { hi() { println "A"; } }
class D2 < D1 {}
D2().hi();

class E1 { hi() { println "A"; } }
class E2 < E1 { hi() { super.hi(); println "B"; } }
E2().hi();

class F1 { init(n) { this.n = n; } }
class F2 < F1 { init(n) { super.init(n); this.m = 1; } }
var f = F2(5);
println f.n;
println f.m;

// a different parameter count adds to the inherited overloads
class G1 { f(a) { return 1; } }
class G2 < G1 { f(a, b) { return 2; } }
var g = G2();
println g.f(0);
println g.f(0, 0);

class P1 { init(a) { this.a = a; } }
class P2 < P1 { init(a, b) { this.a = a; this.b = b; } }
println P2(1).a;
println P2(1, 2).b;

// the same parameter count overrides
class O1 { f(a) { return "parent"; } }
class O2 < O1 { f(a) { return "child"; } }
println O2().f(0);

// a field hides a method
class H { f() { return 1; } }
var h = H();
h.f = 2;
println h.f;

// instances are equal only to themselves
var x1 = A();
var x2 = A();
println x1 == x2;
println x1 == x1;

// instances are passed by reference
class Counter {}
func inc(c) { c.count = c.count + 1; }
var c = Counter();
c.count = 0;
inc(c);
inc(c);
println c.count;

// this is captured by closures
class K { make() { func inner() { return this; } return inner; } }
var k = K();
println k.make()() == k;

// super works through a chain
class C1 { hi() { println "A"; } }
class C2 < C1 {}
class C3 < C2 { hi() { super.hi(); } }
C3().hi();

// polymorphism
class Animal { speak() { println "..."; } }
class Dog < Animal { speak() { println "Woof"; } }
class Cat < Animal { speak() { println "Meow"; } }
func makeSound(animal) { animal.speak(); }
makeSound(Animal());
makeSound(Dog());
makeSound(Cat());
