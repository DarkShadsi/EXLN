// Expressions: arithmetic, comparison, equality, truthiness, logic
println 1 + 2;
println 10 / 4;
println 7 - 10;
println 2 * 3 + 4;
println 2 * (3 + 4);
println "a" + "b";
println -5;
println !null;
println !0;
println 5 == 5;
println 5 == "5";
println null == null;
println 1 < 2;
println 2 <= 2;
println 3 > 4;
println 3 >= 3;
println null or "x";
println 1 and 2;
println false and 1;
println 0 or 5;
println "" == "";
println 1 - 2 - 3;
println true == true;
