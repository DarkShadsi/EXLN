// Step 6: functions, return, recursion, closures, overloading, built-ins
func add(a, b) { return a + b; }
println add(2, 3);

func hi() { println "hi"; }
hi();

func f() {}
println f();

func fact(n) { if (n <= 1) return 1; return n * fact(n - 1); }
println fact(5);

func fib(n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); }
println fib(6);

func count(n) { if (n == 0) return; println n; count(n - 1); }
count(3);

func make() {
    var c = 0;
    func inc() { c = c + 1; return c; }
    return inc;
}
var k = make();
println k();
println k();

// overloading by parameter count
func area(s) { return s * s; }
func area(w, h) { return w * h; }
println area(4);
println area(3, 5);
var g = area;
println g(3);
println add;

func twice(x) { return x + x; }
println twice(4);
println twice("ha");
println twice(2.5);

// an overload in an inner scope does not touch the outer one
{
    func area(s) { return 100; }
    println area(0);
}
println area(4);

// built-in conversions
println toNumber("123") + 1;
println toNumber("-5");
println toNumber(true);
println toString(456) + "!";
println toBoolean(0);
println toBoolean(5);

// pass by value
func addOne(n) { n = n + 1; return n; }
var x = 5;
println addOne(x);
println x;
