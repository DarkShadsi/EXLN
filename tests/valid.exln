// ===== Variables and types =====
var count = 10;
var price = 19.5;
var name = "EXLN";
var active = true;
var nothing = null;
var unset;

// ===== Operators =====
var sum = 1 + 2;
var neg = -10;
var greeting = "Hello" + ", World!";
var check = (count >= 5) and !(price < 1);
var same = count == 10;
var diff = name != "Other";
print sum * 2 / 4 - 1;

// ===== Truthiness =====
if (0) print "0 is truthy";
if ("") print "empty string is truthy";
if (nothing) print "never printed";

// ===== Conversions =====
var n = toNumber("123");
var s = toString(456);
var b = toBoolean(0);
var z = toNumber(true);

// ===== Two-way selection =====
var age = 20;
if (age >= 18) print "Adult";

var score = 70;
if (score >= 75) {
    print "Passed";
}
else {
    print "Failed";
}

if (score >= 90) {
    print "A";
}
else if (score >= 70) {
    print "B";
}
else {
    print "C";
}

// ===== Enums =====
enum Color { RED, GREEN, BLUE }
enum Size { SMALL, MEDIUM, LARGE }
var c = Color.GREEN;
var nextColor = c;
if (c == Color.GREEN) print "Go";
var isRed = (c != Color.RED);
print c.order();

// ===== N-way selection =====
switch (c) {
    case Color.RED:   print "Stop";
    case Color.GREEN: print "Go";
    default:          print "Unknown";
}

var day = 3;
switch (day) {
    case 1:  print "Monday";
    case 3:  print "Wednesday";
    default: print "Other day";
}

// ===== Arrays =====
var nums = [4, 8, 15];
nums[1] = 9;
print nums[1];
print length(nums);
var grid = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
print grid[2][0];

// ===== Counter-controlled loop =====
for (var i = 1; i <= 5; i = i + 1) {
    print i;
}

var total = 0;
for (var j = 0; j < 10; j = j + 2) {
    total = total + j;
}

// ===== Logic-controlled loops =====
var k = 3;
while (k > 0) {
    print k;
    k = k - 1;
}

var x = 10;
do {
    print x;
    x = x + 1;
} while (x < 5);

// ===== break and continue (nested loops, arrays) =====
for (var r = 0; r < length(grid); r = r + 1) {
    for (var q = 0; q < length(grid[r]); q = q + 1) {
        if (grid[r][q] == 5) {
            print "Found 5";
            break;
        }
    }
}

var data = [[3, -1, 4], [-5, 9, 2]];
var positives = 0;
for (var a = 0; a < length(data); a = a + 1) {
    for (var d = 0; d < length(data[a]); d = d + 1) {
        if (data[a][d] < 0) continue;
        positives = positives + data[a][d];
    }
}
print positives;

// ===== Enum iteration (nested loops) =====
var colors = Color.values();
var sizes = Size.values();
for (var s1 = 0; s1 < length(sizes); s1 = s1 + 1) {
    for (var c1 = 0; c1 < length(colors); c1 = c1 + 1) {
        if (colors[c1] == Color.BLUE) break;
        print sizes[s1].order() * 10 + colors[c1].order();
    }
}

for (var e1 = 0; e1 < length(colors); e1 = e1 + 1) {
    for (var e2 = 0; e2 < length(colors); e2 = e2 + 1) {
        if (colors[e1] == colors[e2]) continue;
        print colors[e1].order() + colors[e2].order();
    }
}

// ===== Functions and recursion =====
func factorial(num) {
    if (num <= 1) return 1;
    return num * factorial(num - 1);
}
print factorial(5);

func fib(m) {
    if (m < 2) return m;
    return fib(m - 1) + fib(m - 2);
}
print fib(6);

// ===== Classes (tentative syntax) =====
class Person {
    greet() {
        print "Hi, " + this.name;
    }
}

class Student < Person {
    greet() {
        super.greet();
        print "I am a student";
    }
}

var person = Person();
person.name = "Alice";
person.age = 25;
var user = person;
var userName = person.name;
if (person.age >= 18) print "Adult";
person.greet();

var node = Person();
node.value = 42;
node.next = null;
if (node.next != null) print "Has next";

var pupil = Student();
pupil.name = "Bob";
pupil.greet();
