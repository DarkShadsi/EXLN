// ===== SCANNER errors: each should report an error on its own line =====
@Class
_varName
$var

// 2MyVar scans as the number 2 followed by the identifier MyVar.
// The scanner accepts it; the parser should reject it later.
2MyVar

// ===== PARSER errors (try these one at a time after Step 2) =====
// var x = 5              // missing semicolon
// if (a) if (b) print "x"; else print "y";   // else after an unbraced if
// break;                 // break outside a loop
// continue;              // continue outside a loop
// var class = 1;         // reserved word as identifier

// ===== RUNTIME errors (try these one at a time after Step 3) =====
// print "age: " + 25;    // String + Number
// print 5 < "a";         // order operator on non-numbers
// print -"abc";          // unary minus on a String
// print toNumber("abc"); // invalid numeric string
// var arr = [1, 2];
// print arr[5];          // index out of bounds
// print arr["a"];        // non-Number index
// print Color.RED + 1;   // arithmetic on an enum

// ===== SCANNER error: unterminated string (keep this last) =====
"unterminated
