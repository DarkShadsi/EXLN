// Expressions: arithmetic, comparison, equality, truthiness, logic
print 1 + 2;
print 10 / 4;
print 7 - 10;
print 2 * 3 + 4;
print 2 * (3 + 4);
print "a" + "b";
print -5;
print !null;
print !0;
print 5 == 5;
print 5 == "5";
print null == null;
print 1 < 2;
print 2 <= 2;
print 3 > 4;
print 3 >= 3;
print null or "x";
print 1 and 2;
print false and 1;
print 0 or 5;
print "" == "";
print 1 - 2 - 3;
print true == true;
